# Server-only configuration. Copy to a protected .env for local development.
# Start explicitly with: node --env-file=.env --import tsx server/index.ts
# Release builds do not load .env files or expose VITE_ variables.
NODE_ENV=development
WALLET_NETWORK=mainnet
WALLET_HOST=127.0.0.1
WALLET_PORT=8790
WALLET_ALLOWED_ORIGINS=http://127.0.0.1:5173
WALLET_STATIC_DIR=./dist
WALLET_MIN_CONFIRMATIONS=2
# Core mempool scan limits, independent of WALLET_MAX_HISTORY_TRANSACTIONS.
# A larger mempool returns complete=false for every wallet.
# WALLET_MAX_MEMPOOL_TRANSACTIONS=5000
# WALLET_MAX_MEMPOOL_HEX_CHARACTERS=16000000
# When unset, edges default to 20 x WALLET_MAX_MEMPOOL_TRANSACTIONS.
# WALLET_MAX_MEMPOOL_EDGES=100000
CORE_RPC_URL=http://127.0.0.1:39242
# Set a private, absolute cookie path, or use both RPC fields below.
CORE_COOKIE_FILE=
CORE_RPC_USER=
CORE_RPC_PASSWORD=
WALLET_EXPLORER_URL=https://tscscan.xyz
WALLET_SEED_URL=https://mempool.tensorcash.org
# Regtest only: isolated loopback RPC on port 19453, never a funded node.
# WALLET_NETWORK=regtest
# CORE_RPC_URL=http://127.0.0.1:19453
# WALLET_ALLOW_WATCH_CREATION=true
