{
  "name": "tensorcash-wallet-web",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:gateway": "NODE_ENV=development tsx server/index.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "tsx server/index.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "build:dev": "node scripts/build.mjs --development",
    "verify-build": "node scripts/verify-build.mjs",
    "check-publication": "node scripts/check-publication.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "fastify": "5.12.5",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
